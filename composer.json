{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "laravel/react-starter-kit",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "akira/laravel-auth-logs": "^1.0.0",
    "akira/laravel-commentable": "1.x-dev",
    "akira/laravel-followable": "^0.2.0",
    "akira/laravel-likeable": "^0.2.0",
    "inertiajs/inertia-laravel": "^2.0.2",
    "laravel/framework": "^12.9.2",
    "laravel/horizon": "^5.31",
    "laravel/nightwatch": "^1.7",
    "laravel/pulse": "^1.4",
    "laravel/reverb": "^1.0",
    "laravel/sanctum": "^4.0",
    "laravel/scout": "^10.14",
    "laravel/socialite": "^5.19",
    "laravel/tinker": "^2.10.1",
    "laravel/wayfinder": "^0.1.12",
    "league/flysystem-aws-s3-v3": "^3.0",
    "meilisearch/meilisearch-php": "^1.14",
    "panphp/pan": "^0.1.8",
    "pinkary-project/type-guard": "^0.1.0",
    "spatie/laravel-medialibrary": "^11.12",
    "spatie/laravel-query-builder": "^6.3",
    "spatie/laravel-route-attributes": "^1.25"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.15",
    "fakerphp/faker": "^1.24.1",
    "laravel/boost": "^1.2",
    "laravel/pail": "^1.2.2",
    "laravel/pint": "^1.22",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.8",
    "peckphp/peck": "^0.1.3",
    "pestphp/pest": "^v4.0.0",
    "pestphp/pest-plugin-laravel": "^v4.0.0",
    "pestphp/pest-plugin-type-coverage": "^v4.0.0",
    "rector/rector": "^2.0.11",
    "spatie/laravel-ray": "^1.40"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "dev:ssr": [
      "npm run build:ssr",
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
    ],
    "lint": "pint",
    "refactor": "rector",
    "test:lint": "pint --test",
    "test:refactor": "rector --dry-run",
    "test:types": "phpstan",
    "test:arch": "pest --filter=arch --parallel",
    "test:type-coverage": "pest --type-coverage --min=100 --compact --parallel",
    "test:coverage": "pest --parallel --coverage --compact --exactly=99.1",
    "test:typos": "peck",
    "test": [
      "@php artisan config:clear --ansi",
      "@test:lint",
      "@test:refactor",
      "@test:typos",
      "@test:arch",
      "@test:types",
      "@test:coverage",
      "@test:type-coverage"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
