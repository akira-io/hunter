			identifier: generics.notGeneric
			count: 1
			path: app/Services/Search/Providers/HuntSearchProvider.php

		-
			message: '#^Parameter \#1 \$model of method App\\Services\\Search\\Providers\\HuntSearchProvider\:\:buildRedirectUrl\(\) expects App\\Models\\Hunt, object given\.$#'
			identifier: argument.type
			count: 1
			path: app/Services/Search/Providers/HuntSearchProvider.php

		-
			message: '#^Parameter \#1 \$model of method App\\Services\\Search\\Providers\\HuntSearchProvider\:\:mapToDto\(\) expects App\\Models\\Hunt, Illuminate\\Database\\Eloquent\\Model given\.$#'
			identifier: argument.type
			count: 1
			path: app/Services/Search/Providers/HuntSearchProvider.php

		-
			message: '#^Parameter \#3 \.\.\.\$values of function sprintf expects bool\|float\|int\|string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: app/Services/Search/Providers/HuntSearchProvider.php

		-
			message: '#^Cannot access constant class on mixed\.$#'
			identifier: classConstant.nonObject
			count: 1
			path: app/Services/Search/Providers/UserSearchProvider.php

		-
