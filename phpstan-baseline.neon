parameters:
	ignoreErrors:
		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 1
			path: app/Http/Requests/Chat/SendMessageRequest.php

		-
			message: '#^Parameter \$groups of class App\\DataTransferObjects\\Search\\GlobalSearchResponseDto constructor expects array\<App\\DataTransferObjects\\Search\\SearchGroupDto\>, array\<int, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Services/Search/GlobalSearchService.php

		-
			message: '#^Cannot access constant class on mixed\.$#'
			identifier: classConstant.nonObject
			count: 1
			path: app/Services/Search/Providers/HuntSearchProvider.php

		-
			message: '#^Cannot call method take\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Services/Search/Providers/HuntSearchProvider.php

		-
			message: '#^Cannot call static method search\(\) on mixed\.$#'
			identifier: staticMethod.nonObject
			count: 1
			path: app/Services/Search/Providers/HuntSearchProvider.php

		-
			message: '#^Method App\\Services\\Search\\Providers\\HuntSearchProvider\:\:buildQuery\(\) return type with generic class Laravel\\Scout\\Builder does not specify its types\: TModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Services/Search/Providers/HuntSearchProvider.php

		-
			message: '#^Method App\\Services\\Search\\Providers\\HuntSearchProvider\:\:buildQuery\(\) should return Laravel\\Scout\\Builder but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: app/Services/Search/Providers/HuntSearchProvider.php

		-
